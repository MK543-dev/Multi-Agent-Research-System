# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in your own keys:
#     cp .env.example .env        # Windows PowerShell: Copy-Item .env.example .env
# ".env" is git-ignored - never commit real credentials.
# ---------------------------------------------------------------------------

# Required: OpenAI key used for GPT-4o-mini (Writer / Critic / Reader agents).
OPENAI_API_KEY=sk-replace-with-your-openai-key

# Required: Tavily key used by the Search agent.
# Free tier: https://app.tavily.com/home
TAVILY_API_KEY=tvly-replace-with-your-tavily-key

# ---------------------------------------------------------------------------
# Optional overrides (defaults shown). Safe to delete.
# ---------------------------------------------------------------------------
OPENAI_MODEL=gpt-4o-mini
MAX_SOURCES=5
MAX_PAGES=4
REQUEST_TIMEOUT=15
